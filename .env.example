# Copy to .env for local development. Never commit .env.
# On Vercel, set these in Project Settings -> Environment Variables instead.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-project.vercel.app

# Leave empty locally to use SQLite. Production: Neon / Vercel Postgres URL.
DATABASE_URL=
# Example: postgres://user:password@host:5432/dbname?sslmode=require

# MongoDB Atlas (chat logs + feedback). Leave empty to disable logging.
MONGODB_URI=
# Example: mongodb+srv://user:password@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=maison_heure

# Claude replies for the concierge chat. Leave empty to use FAQ/error-code answers + tickets only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Optional: currency API override (defaults to open.er-api.com)
# FX_API_URL=https://open.er-api.com/v6/latest/INR
